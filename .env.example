# Same Kool backend as the KoolBuy web marketplace (NEXT_PUBLIC_API_BASE_URL there).
# /api/v1 is added if missing. On a phone in development, 127.0.0.1 is swapped
# for the LAN IP Metro serves from, so this works on simulators and devices.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Production:
# EXPO_PUBLIC_API_BASE_URL=https://koolkonnect.koolboksng.com

# The web marketplace — Paystack returns buyers here, and "open on web" links use it.
EXPO_PUBLIC_WEB_BASE_URL=https://koolbuystoremarketplace.com
